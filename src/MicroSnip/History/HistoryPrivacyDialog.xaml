<Window x:Class="MicroSnip.History.HistoryPrivacyDialog"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MicroSnip history"
        Width="500"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="#0F1115"
        FontFamily="Segoe UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale">
    <Window.Resources>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#222833" />
            <Setter Property="Foreground" Value="#E8EDF4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#2C3542" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#36404F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton"
               TargetType="Button"
               BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Background" Value="#0A84FF" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#2B95FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#0070DD" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Padding="24,22,24,20">
        <StackPanel>
            <TextBlock FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#F4F6F9"
                       Text="Snips are saved in your history" />
            <TextBlock Margin="0,8,0,0"
                       FontSize="13"
                       Foreground="#A5AFBD"
                       LineHeight="19"
                       TextWrapping="Wrap"
                       Text="MicroSnip keeps the history on this PC so you can review, search, and copy earlier snips. You can turn it off or delete entries at any time." />
            <Border Margin="0,16,0,0"
                    Padding="16,14"
                    Background="#171A21"
                    BorderBrush="#242A35"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="#E8EDF4"
                               Text="What history contains" />
                    <TextBlock Margin="0,8,0,0"
                               FontSize="12.5"
                               Foreground="#A5AFBD"
                               LineHeight="18"
                               TextWrapping="Wrap"
                               Text="The recognized text and, when image saving is enabled, the captured screenshot. Nothing is uploaded, sent, or synced." />
                    <TextBlock Margin="0,12,0,0"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="#E8EDF4"
                               Text="Where it is stored" />
                    <TextBlock x:Name="StorageText"
                               Margin="0,6,0,0"
                               FontFamily="Consolas"
                               FontSize="12"
                               Foreground="#C9D2DE"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,12,0,0"
                               FontSize="12.5"
                               Foreground="#A5AFBD"
                               LineHeight="18"
                               TextWrapping="Wrap"
                               Text="Open History from the tray to delete individual snips, clear everything, or export. Pause history for one hour from the tray menu." />
                </StackPanel>
            </Border>
            <StackPanel Margin="0,22,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Content="History settings"
                        Style="{StaticResource SecondaryButton}"
                        Click="OnOpenSettingsClicked"
                        AutomationProperties.Name="Open history settings" />
                <Button x:Name="AcceptButton"
                        Content="Got it"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButton}"
                        Click="OnAcceptClicked"
                        AutomationProperties.Name="Accept history privacy notice" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
