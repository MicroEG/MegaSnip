<Window x:Class="MegaSnip.Toast.ToastWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MegaSnip notification"
        Width="460"
        SizeToContent="Height"
        WindowStyle="None"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        Opacity="0"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale">
    <Window.Resources>
        <Style x:Key="ToastActionButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#6CB8FF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#1F6CB8FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#336CB8FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToastCloseButton"
               TargetType="Button"
               BasedOn="{StaticResource ToastActionButton}">
            <Setter Property="Foreground" Value="#9AA4B2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="Margin" Value="2,0,0,0" />
        </Style>
    </Window.Resources>
    <Border Background="#F5171A21"
            BorderBrush="#2D3542"
            BorderThickness="1"
            CornerRadius="10"
            Padding="16,14">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="IconBackground"
                    Width="28"
                    Height="28"
                    Margin="0,1,12,0"
                    VerticalAlignment="Top"
                    Background="#26FF9F0A"
                    CornerRadius="14">
                <TextBlock x:Name="IconText"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontFamily="Segoe UI Symbol"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="#FF9F0A"
                           Text="!" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText"
                           FontSize="13.5"
                           FontWeight="SemiBold"
                           Foreground="#F4F6F9"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="DetailText"
                           Margin="0,3,0,0"
                           FontSize="12"
                           Foreground="#A5AFBD"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
            </StackPanel>
            <StackPanel Grid.Column="2"
                        Margin="12,0,0,0"
                        VerticalAlignment="Top"
                        Orientation="Horizontal">
                <Button x:Name="PreviewButton"
                        Content="Preview"
                        Style="{StaticResource ToastActionButton}"
                        Click="OnPreviewClicked"
                        AutomationProperties.Name="Preview captured text" />
                <Button x:Name="DiscardHistoryButton"
                        Content="Don't log this"
                        Style="{StaticResource ToastCloseButton}"
                        Click="OnDiscardHistoryClicked"
                        Visibility="Collapsed"
                        ToolTip="Remove this snip from history"
                        AutomationProperties.Name="Do not save this snip to history" />
                <Button Content="✕"
                        Style="{StaticResource ToastCloseButton}"
                        Click="OnCloseClicked"
                        AutomationProperties.Name="Dismiss notification" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
