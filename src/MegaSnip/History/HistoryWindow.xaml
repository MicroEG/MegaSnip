<Window x:Class="MegaSnip.History.HistoryWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MegaSnip history"
        Width="1120"
        Height="720"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#0F1115"
        FontFamily="Segoe UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        PreviewKeyDown="OnWindowPreviewKeyDown">
    <Window.Resources>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#222833" />
            <Setter Property="Foreground" Value="#E8EDF4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#2C3542" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#36404F" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton"
               TargetType="Button"
               BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Background" Value="#0A84FF" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#2B95FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#0070DD" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GhostButton"
               TargetType="Button"
               BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#A5AFBD" />
        </Style>
        <Style x:Key="DangerButton"
               TargetType="Button"
               BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Background" Value="#351E22" />
            <Setter Property="Foreground" Value="#FF9A94" />
        </Style>
        <Style x:Key="MetaText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A94A6" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="MetaDot" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#465062" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CaretBrush" Value="#F4F6F9" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#F1F4F8" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="HistoryEditor" TargetType="TextBox">
            <Setter Property="Background" Value="#12161D" />
            <Setter Property="BorderBrush" Value="#242A35" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="#F4F6F9" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="#EDF1F7" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="SelectionBrush" Value="#2B6CB0" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="AcceptsTab" Value="False" />
            <Setter Property="SpellCheck.IsEnabled" Value="False" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                          HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#0A84FF" />
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Padding="18,16,18,14">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#F4F6F9"
                           Text="Snip history" />
                <TextBlock Margin="0,4,0,0"
                           FontSize="12"
                           Foreground="#7E8898"
                           Text="Every capture is stored locally. Nothing leaves this PC." />
            </StackPanel>
            <TextBlock Grid.Column="1"
                       VerticalAlignment="Bottom"
                       FontSize="12"
                       Foreground="#7E8898"
                       Text="{Binding CountText}" />
        </Grid>
        <Grid Grid.Row="1" Margin="0,16,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="300"
                    Height="34"
                    Padding="11,0"
                    HorizontalAlignment="Left"
                    Background="#171A21"
                    BorderBrush="#2B3240"
                    BorderThickness="1"
                    CornerRadius="6">
                <DockPanel VerticalAlignment="Center">
                    <TextBlock Margin="0,0,9,0"
                               VerticalAlignment="Center"
                               FontSize="11.5"
                               Foreground="#66707F"
                               Text="Search" />
                    <TextBox x:Name="SearchBox"
                             Style="{StaticResource SearchBox}"
                             TextChanged="OnSearchTextChanged"
                             AutomationProperties.Name="Search history" />
                </DockPanel>
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="ExportButton"
                        Content="Export"
                        Style="{StaticResource SecondaryButton}"
                        Click="OnExportClicked"
                        AutomationProperties.Name="Export history" />
                <Button x:Name="DeleteSelectedButton"
                        Content="Delete selected"
                        Style="{StaticResource SecondaryButton}"
                        Click="OnDeleteSelectedClicked"
                        AutomationProperties.Name="Delete selected snips" />
                <Button x:Name="ClearAllButton"
                        Content="Clear all"
                        Style="{StaticResource DangerButton}"
                        Click="OnClearAllClicked"
                        AutomationProperties.Name="Clear all history" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" MinWidth="260" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="420" />
            </Grid.ColumnDefinitions>
            <Border Background="#12161D"
                    BorderBrush="#242A35"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <ListBox x:Name="HistoryList"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemsSource="{Binding Entries}"
                             SelectionMode="Extended"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                             SelectionChanged="OnListSelectionChanged"
                             PreviewKeyDown="OnListPreviewKeyDown"
                             MouseDoubleClick="OnListMouseDoubleClick"
                             AutomationProperties.Name="Snip history list">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="5,2" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Row"
                                                    Padding="8"
                                                    Background="Transparent"
                                                    CornerRadius="6">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="#1A2029" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="#1E3A5F" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="56"
                                            Height="40"
                                            VerticalAlignment="Center"
                                            Background="#0B0E13"
                                            CornerRadius="4"
                                            ClipToBounds="True">
                                        <Grid>
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="9"
                                                       Foreground="#4A5568"
                                                       Text="TEXT">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasImage}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Image Source="{Binding Thumbnail}"
                                                   Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1"
                                                Margin="10,0,8,0"
                                                VerticalAlignment="Center">
                                        <TextBlock FontSize="12.5"
                                                   Foreground="#EDF1F7"
                                                   Text="{Binding FirstLine}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,3,0,0"
                                                   FontSize="10.5"
                                                   Foreground="#7E8898"
                                                   Text="{Binding DisplayTime}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2"
                                               VerticalAlignment="Center"
                                               FontSize="10"
                                               Foreground="#66707F"
                                               Text="{Binding CharacterCountText}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="28"
                                IsHitTestVisible="False"
                                Visibility="{Binding EmptyStateVisibility}">
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="13"
                                   Foreground="#7E8898"
                                   LineHeight="20"
                                   Text="{Binding EmptyStateText}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
            <GridSplitter Grid.Column="1"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          ShowsPreview="True" />
            <Border Grid.Column="2"
                    Background="#12161D"
                    BorderBrush="#242A35"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid x:Name="DetailContent"
                          Margin="18,16,18,14"
                          Visibility="{Binding DetailVisibility}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="3*" MinHeight="90" />
                            <RowDefinition Height="2*" MinHeight="70" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="#F4F6F9"
                                       Text="{Binding SelectedTimeText}" />
                            <WrapPanel Margin="0,7,0,0">
                                <TextBlock Style="{StaticResource MetaText}"
                                           Text="{Binding SelectedDimensionsText}" />
                                <TextBlock Style="{StaticResource MetaDot}" Text="·" />
                                <TextBlock Style="{StaticResource MetaText}"
                                           Text="{Binding SelectedCharacterCountText}" />
                                <TextBlock Style="{StaticResource MetaDot}" Text="·" />
                                <TextBlock Style="{StaticResource MetaText}"
                                           Text="{Binding SelectedLanguageText, StringFormat='OCR: {0}'}" />
                                <TextBlock Style="{StaticResource MetaDot}" Text="·" />
                                <TextBlock Style="{StaticResource MetaText}"
                                           Text="{Binding SelectedAppVersionText, StringFormat='App {0}'}" />
                            </WrapPanel>
                            <TextBlock Margin="0,4,0,0"
                                       FontSize="10.5"
                                       Foreground="#5C6678"
                                       Text="{Binding SelectedMonitorText, StringFormat='Captured on {0}'}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Border Grid.Row="1"
                                Margin="0,14,0,0"
                                Background="#0B0E13"
                                CornerRadius="6"
                                ClipToBounds="True">
                            <Grid>
                                <Image Source="{Binding SelectedImage}"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       AutomationProperties.Name="Saved snip image" />
                                <TextBlock Margin="18"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="#66707F"
                                           Text="{Binding ImageMessage}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding ImageMessageVisibility}" />
                            </Grid>
                        </Border>
                        <TextBox x:Name="TextEditor"
                                 Grid.Row="2"
                                 Margin="0,14,0,12"
                                 Style="{StaticResource HistoryEditor}"
                                 TextChanged="OnEditorTextChanged"
                                 LostKeyboardFocus="OnEditorLostKeyboardFocus"
                                 AutomationProperties.Name="Recognized text" />
                        <Grid Grid.Row="3">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="EditorCharacterCountText"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="#66707F" />
                            <WrapPanel Grid.Row="1"
                                       Margin="0,8,0,0"
                                       HorizontalAlignment="Right"
                                       Orientation="Horizontal">
                                <Button x:Name="CopyTextButton"
                                        Content="Copy text"
                                        Style="{StaticResource PrimaryButton}"
                                        Click="OnCopyTextClicked"
                                        AutomationProperties.Name="Copy text" />
                                <Button x:Name="CopyImageButton"
                                        Content="Copy image"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="OnCopyImageClicked"
                                        AutomationProperties.Name="Copy image" />
                                <Button x:Name="CopyBothButton"
                                        Content="Copy both"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="OnCopyBothClicked"
                                        AutomationProperties.Name="Copy text and image" />
                                <Button x:Name="RerunButton"
                                        Content="Re-run OCR"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="OnRerunClicked"
                                        AutomationProperties.Name="Re-run OCR" />
                                <Button x:Name="OpenFolderButton"
                                        Content="Open folder"
                                        Style="{StaticResource GhostButton}"
                                        Click="OnOpenFolderClicked"
                                        AutomationProperties.Name="Open snip folder" />
                                <Button x:Name="DeleteButton"
                                        Content="Delete"
                                        Style="{StaticResource DangerButton}"
                                        Click="OnDeleteClicked"
                                        AutomationProperties.Name="Delete this snip" />
                            </WrapPanel>
                        </Grid>
                    </Grid>
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Visibility="{Binding DetailEmptyVisibility}">
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="13"
                                   Foreground="#7E8898"
                                   Text="Select a snip to review its text and image."
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="3" Margin="2,10,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock FontSize="11.5"
                       Foreground="{Binding StatusBrush}"
                       Text="{Binding StatusMessage}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1"
                       FontSize="11"
                       Foreground="#5C6678"
                       Text="Ctrl+C text · Ctrl+Shift+C image · Del deletes · changes save automatically" />
        </Grid>
    </Grid>
    </Border>
</Window>
